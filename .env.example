# Copy to .env and fill in values. Never commit real values.
# (required) = startup fails with ImproperlyConfigured if unset.

# Django Configuration
# (required)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
# (required) comma-separated
DJANGO_ALLOWED_HOSTS=

# Database
# Set to True to use local SQLite instead of PostgreSQL
USE_SQLITE=
# PostgreSQL (required unless USE_SQLITE=True)
POSTGRES_DB=
POSTGRES_USER=
# Must be defined; may be empty
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Azure Storage (Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Django API URLs
DJANGO_API_URL=
DJANGO_PUBLIC_API_URL=
DJANGO_FINANCE_API_URL=

# Teams / Azure Entra ID (from App Registration)
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Teams Service Configuration (optional)
TEAMS_SERVICE_URL=

# Redis / Celery Worker
# (required)
REDIS_URL=

# Receipt Processing Rules
MAX_RECEIPT_UPLOAD_MB=
MAX_RECEIPT_COMPRESSION_THRESHOLD_MB=
RECEIPT_MAX_AGE_DAYS=

# Duplicate Detection Thresholds
DUPLICATE_SCORE_THRESHOLD=
REVIEW_SCORE_THRESHOLD=

# Hybrid Category Classifier
CLASSIFIER_KEYWORD_WEIGHT=
CLASSIFIER_SEMANTIC_WEIGHT=
CLASSIFIER_CONFIDENCE_THRESHOLD=
CLASSIFIER_AMBIGUITY_MARGIN=
CLASSIFIER_SEMANTIC_MODEL=

# File Compression
IMAGE_COMPRESSION_QUALITY=
IMAGE_MAX_PIXELS=
PDF_COMPRESSION_ENABLED=

# Django Upload Limits (bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=
DATA_UPLOAD_MAX_MEMORY_SIZE=

# User Manual
MANUAL_BLOB_PATH=

# CORS
# (required) comma-separated
CORS_ALLOWED_ORIGINS=
