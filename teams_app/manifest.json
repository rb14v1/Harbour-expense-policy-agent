{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.14/MicrosoftTeams.schema.json",
  "manifestVersion": "1.14",
  "version": "1.0.0",
  "id": "12345678-1234-5678-1234-567812345678",
  "packageName": "com.expensepolicy.agent",
  "developer": {
    "name": "Expense Policy Team",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "Expense Policy Agent",
    "full": "Expense Policy Agent - Receipt Processing"
  },
  "description": {
    "short": "Upload and manage expense receipts with automatic duplicate detection and policy validation",
    "full": "Process expense receipts with OCR extraction, duplicate detection, and automated policy validation. Upload receipts, get instant status updates, and ensure compliance with expense policies."
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "12345678-1234-5678-1234-567812345678",
      "scopes": [
        "team",
        "personal",
        "groupChat"
      ],
      "commandLists": [
        {
          "scopes": [
            "team",
            "personal",
            "groupChat"
          ],
          "commands": [
            {
              "title": "Upload Receipt",
              "description": "Upload an expense receipt for processing"
            },
            {
              "title": "Check Status",
              "description": "Check the status of a receipt"
            },
            {
              "title": "Help",
              "description": "Get help with using the Expense Policy Agent"
            }
          ]
        }
      ],
      "supportsFiles": true,
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [
    {
      "botId": "12345678-1234-5678-1234-567812345678",
      "commands": [
        {
          "id": "searchReceipts",
          "context": [
            "compose",
            "commandBox"
          ],
          "description": "Search your receipts",
          "title": "Search Receipts",
          "initialRun": false,
          "parameters": [
            {
              "name": "searchQuery",
              "title": "Search",
              "description": "Enter receipt ID or vendor name",
              "inputType": "text"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "example.com",
    "localhost:8000",
    "localhost:3000"
  ],
  "webApplicationInfo": {
    "id": "12345678-1234-5678-1234-567812345678",
    "resource": "api://example.com/12345678-1234-5678-1234-567812345678"
  }
}
